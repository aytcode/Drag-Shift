{
  "name": "drag-shift",
  "productName": "DragShift",
  "author": "aliyigit",
  "version": "1.4.0",
  "description": "Drag any file, press Shift, drop it on an action.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis"
  },
  "dependencies": {
    "jspdf": "2.5.1",
    "jszip": "3.10.1",
    "koffi": "^3.3.3",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "3.11.174"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "app.dragshift",
    "files": [
      "package.json",
      "main.js",
      "input.js",
      "preload.js",
      "index.html",
      "build/icon.png"
    ],
    "asarUnpack": [
      "node_modules/koffi/**"
    ],
    "npmRebuild": false,
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": true,
      "shortcutName": "Drag + Shift",
      "createDesktopShortcut": false
    },
    "icon": "build/icon.png",
    "mac": {
      "target": [
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.utilities",
      "extendInfo": {
        "LSUIElement": true
      }
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility",
      "maintainer": "aliyigit",
      "synopsis": "Drag a file, press Shift, drop it on an action."
    }
  },
  "allowScripts": {
    "electron@33.4.11": true
  },
  "homepage": "https://github.com/aytcode/Drag-Shift"
}
